# Copiá este archivo a ".env" para correr en tu computadora.
# En Render, estas variables se cargan en Settings → Environment, no en este archivo.

# Contraseña para entrar a la aplicación (elegí una fuerte).
# Contraseña del primer administrador (solo se usa si todavía no hay usuarios)
APP_PASSWORD=cambiar-esta-contrasena
# Usuario del primer administrador (opcional, por defecto: admin)
ADMIN_USER=admin

# Cadena aleatoria larga, usada para firmar la sesión. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar-esta-clave-aleatoria

# Conexión a PostgreSQL. En Render se completa sola si conectás una base de datos
# al servicio. En tu computadora, usá la de un Postgres local o uno gratuito en la nube.
DATABASE_URL=postgres://usuario:contrasena@localhost:5432/ovo

# "false" para desactivar SSL en Postgres (por ejemplo, en desarrollo local sin SSL).
# En Render dejalo sin definir (usa SSL por defecto).
# PGSSL=false

# Puerto local (Render define su propio PORT automáticamente).
PORT=3000
